\newlabel{fig:ss_nominal}{{1a}{1}{\edits {Nominal stability}}{figure.caption.1}{}}
\newlabel{sub@fig:ss_nominal}{{a}{1}{\edits {Nominal stability}}{figure.caption.1}{}}
\newlabel{fig:ss_robust}{{1b}{1}{\edits {Robust and stochastic stability}}{figure.caption.1}{}}
\newlabel{sub@fig:ss_robust}{{b}{1}{\edits {Robust and stochastic stability}}{figure.caption.1}{}}
